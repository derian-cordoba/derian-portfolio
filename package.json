{
  "name": "derian-portfolio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "npm run check && npm run lint && npm run format:check && npm test && npm run build && npm run test:static",
    "test:static": "node --test tests/integration/static-output.test.ts",
    "test:deployed": "node --test --test-concurrency=1 tests/deployment/*.test.ts",
    "capture:gateway": "node scripts/capture-gateway.mjs",
    "record:gateway": "node scripts/render-gateway-recording.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "axe-core": "^4.11.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "^3.7.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "esbuild": "^0.28.1"
  }
}
