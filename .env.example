SITE_URL=https://derian-cordoba.me
# Enable only when deploying to Netlify with Forms detection enabled.
PUBLIC_CONTACT_FORM_ENABLED=false
# Optional: paste the site-specific https://plausible.io/js/pa-....js URL.
# Empty disables all external analytics. Production hostname only; previews excluded.
PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Optional measurement host override, independent of the future canonical domain.
# Example: derian-cordoba-portfolio.netlify.app
PUBLIC_ANALYTICS_HOSTNAME=
# Set to open only after explicitly choosing to advertise availability.
PORTFOLIO_AVAILABILITY=
# Optional public HTML verification value from a Search Console URL-prefix property.
PUBLIC_GOOGLE_SITE_VERIFICATION=
