---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionLink from '@/components/ui/ActionLink.astro';
---

<BaseLayout title="Page not found — Derian Córdoba" noindex
  ><section class="shell py-28">
    <p class="eyebrow text-blue">404 / Page not found</p><h1
      class="display-title mt-5 text-5xl"
    >
      A small detour.
    </h1><p class="mt-5 max-w-md text-muted">
      This page isn’t here. You can head back to my selected work or get in
      touch from the homepage.
    </p><ActionLink href="/" class="mt-8">Back to the portfolio</ActionLink>
  </section></BaseLayout
>
