---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
}

const { href, target, rel, ...attributes } = Astro.props;
const origin = Astro.site ?? Astro.url;
const destination = new URL(href, origin);
const external =
  ['http:', 'https:'].includes(destination.protocol) &&
  destination.origin !== origin.origin;
const relationship = external
  ? [
      ...new Set([
        ...(rel?.split(/\s+/u).filter(Boolean) ?? []),
        'noopener',
        'noreferrer',
      ]),
    ].join(' ')
  : rel;
---

<a
  {...attributes}
  href={href}
  target={external ? '_blank' : target}
  rel={relationship}
>
  <slot />
</a>
