---
interface Props {
  number: string;
  label: string;
  title: string;
  description?: string;
}
const { number, label, title, description } = Astro.props;
---

<div
  class="mb-10 flex flex-col justify-between gap-6 md:mb-14 md:flex-row md:items-end"
>
  <div>
    <p class="eyebrow mb-4 text-muted">
      <span class="mr-3 font-mono text-blue">{number}</span>{label}
    </p>
    <h2 class="display-title text-3xl sm:text-4xl lg:text-[42px]">{title}</h2>
  </div>
  {
    description && (
      <p class="max-w-xs text-sm leading-relaxed text-muted">{description}</p>
    )
  }
</div>
