---
import { getTranslations } from '@/i18n';
import { getLocale } from '@/i18n/routing';
import { createGatewayViewModel } from '@/presentation/view-models/gateway-view-model';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
const initial = createGatewayViewModel('healthy', locale);
---

<gateway-demo
  lang={locale}
  class="my-12 block rounded-xl border border-line bg-white/50 p-5 sm:p-7"
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="font-display text-lg font-semibold">
      {t.demoTitle}
    </h2><span class="tag">{t.demoLabel}</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-muted">
    {t.demoDescription}
  </p>
  <div class="mt-6 grid grid-cols-2 gap-3">
    <div class="rounded-md bg-blue-light p-4">
      <p class="eyebrow text-muted">{t.response}</p><p
        class="mt-2 font-mono text-lg text-blue"
      >
        <span data-status>{initial.status}</span>
        <span data-status-label class="text-xs">{initial.statusLabel}</span>
      </p>
    </div><div class="rounded-md bg-blue-light p-4">
      <p class="eyebrow text-muted">{t.circuit}</p><p
        data-circuit
        class="mt-2 font-mono text-lg text-blue"
      >
        {initial.circuit}
      </p>
    </div>
  </div>
  <div role="status" aria-live="polite" aria-atomic="true">
    <p data-message class="mt-4 text-sm leading-relaxed text-muted">
      {initial.message}
    </p>
  </div>
  <button
    type="button"
    class="mt-5 min-h-11 rounded-md bg-blue px-4 py-3 text-xs font-semibold text-white hover:bg-navy"
    hidden>{initial.buttonLabel}</button
  >
  <noscript
    ><p class="mt-4 text-xs text-muted">
      {t.demoNoScript}
    </p></noscript
  >
</gateway-demo>
<script>
  import { GatewayDemoElement } from '@/presentation/controllers/gateway-demo-element';
  if (!customElements.get('gateway-demo')) {
    customElements.define('gateway-demo', GatewayDemoElement);
  }
</script>
