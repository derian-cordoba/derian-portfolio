---
import { profile } from '@/content/profile';
import { getFeatureCopy } from '@/i18n/features';
import { getLocale } from '@/i18n/routing';
const copy = getFeatureCopy(getLocale(Astro.url.pathname));
---

<copy-email
  data-email={profile.email}
  data-success={copy.copied}
  data-error={copy.copyFailed}
  class="mt-3 block"
>
  <button
    type="button"
    hidden
    class="min-h-11 rounded-md border border-white/40 px-4 py-2 text-sm text-white hover:bg-white/10"
    >{copy.copyEmail}</button
  >
  <p
    data-feedback
    role="status"
    aria-live="polite"
    class="mt-2 text-xs leading-relaxed text-blue-100"
  >
  </p>
</copy-email>
<script>
  import { CopyEmailElement } from '@/presentation/controllers/copy-email-element';
  if (!customElements.get('copy-email')) {
    customElements.define('copy-email', CopyEmailElement);
  }
</script>
