---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/ui/PageHeading.astro';
import ActionLink from '@/components/ui/ActionLink.astro';
import { getFeatureCopy } from '@/i18n/features';
import { localizePath } from '@/i18n/routing';
import type { NoteViewModel } from '@/presentation/view-models/note-view-model';
import NoteByline from '@/components/notes/NoteByline.astro';
interface Props {
  note: NoteViewModel;
}
const { note } = Astro.props;
const copy = getFeatureCopy(note.locale);
const entry = await getEntry('notes', note.contentId);
if (!entry) {
  throw new Error(`Note content is missing: ${note.id}`);
}
const { Content } = await render(entry);
---

<BaseLayout
  title={`${note.title} — Derian Córdoba`}
  description={note.description}
>
  <PageHeading
    eyebrow={copy.notes}
    title={note.title}
    description={note.description}
  />
  <div class="shell pb-24">
    <div class="mb-8"><NoteByline note={note} /></div>
    <article class="case-prose max-w-2xl"><Content /></article>
    <ActionLink
      href={localizePath('/notes/', note.locale)}
      variant="text"
      icon="arrow-right"
      class="mt-12">{copy.backNotes}</ActionLink
    >
  </div>
</BaseLayout>
