---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/ui/PageHeading.astro';
import ActionLink from '@/components/ui/ActionLink.astro';
import { getFeatureCopy } from '@/i18n/features';
import { getLocale, localizePath } from '@/i18n/routing';
import { profile } from '@/content/profile';
const locale = getLocale(Astro.url.pathname);
const copy = getFeatureCopy(locale);
---

<BaseLayout
  title={`${copy.thanksTitle} — Derian Córdoba`}
  description={copy.thanksBody}
  noindex
>
  <PageHeading
    eyebrow={copy.messageTitle}
    title={copy.thanksTitle}
    description={copy.thanksBody}
  />
  <div class="shell flex flex-wrap gap-4 pb-24">
    <ActionLink href={localizePath('/', locale)} icon="arrow-right"
      >{copy.home}
    </ActionLink>
    
    <ActionLink href={`mailto:${profile.email}`} variant="secondary"
      >{copy.email}
    </ActionLink>
  </div>
</BaseLayout>
