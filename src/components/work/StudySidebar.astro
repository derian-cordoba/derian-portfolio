---
import type { StudyViewModel } from '@/presentation/view-models/study-view-model';
import ActionLink from '@/components/ui/ActionLink.astro';
import { getTranslations } from '@/i18n';
import { getEnhancementCopy } from '@/i18n/enhancements';
interface Props {
  study: StudyViewModel;
  contents: readonly { readonly label: string; readonly href: string }[];
}
const { study, contents } = Astro.props;
const t = getTranslations(study.locale);
const copy = getEnhancementCopy(study.locale);
---

<aside
  aria-label={copy.contents}
  class="self-start rounded-lg border border-line bg-surface p-6 lg:sticky lg:top-28 lg:col-start-2 lg:row-start-1"
>
  {
    contents.length > 0 && (
      <nav aria-labelledby="study-contents-heading">
        <h2 id="study-contents-heading" class="eyebrow text-blue">
          {copy.contents}
        </h2>
        <ul class="mt-4 space-y-1">
          {contents.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-md py-2 text-sm leading-relaxed text-muted underline-offset-4 hover:text-blue hover:underline"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  {
    study.repository && (
      <ActionLink
        href={study.repository}
        variant="secondary"
        class="mt-6 w-full text-xs!"
      >
        {t.viewRepository}
      </ActionLink>
    )
  }
  <p class="mt-6 text-xs leading-relaxed text-muted">{study.evidenceNote}</p>
</aside>
