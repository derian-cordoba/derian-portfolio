---
import type { StudyViewModel } from '@/presentation/view-models/study-view-model';
import Icon from '../ui/Icon.astro';
import StudyVisual from '../visuals/StudyVisual.astro';
interface Props {
  study: StudyViewModel;
}
const { study } = Astro.props;
---

<section class="shell pt-10 pb-14 md:pt-14 md:pb-20">
  <a
    href={study.kind === 'experience' ? '/#work' : '/#projects'}
    class="text-link mb-8 text-xs text-muted"
    ><Icon name="arrow-right" class="size-3 rotate-180" />Back to selected work</a
  >
  <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <div>
      <p class="eyebrow text-blue">{study.category}</p><h1
        class="display-title mt-5 text-4xl leading-[1.15] sm:text-5xl"
      >
        {study.title}
      </h1><p class="mt-6 text-base leading-relaxed text-muted">
        {study.description}
      </p><div class="mt-6 flex flex-wrap gap-2">
        {study.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div><p class="mt-6 font-mono text-[10px] text-muted">
        {study.readingTime}
      </p>
    </div><StudyVisual visual={study.visual} />
  </div>
</section>
