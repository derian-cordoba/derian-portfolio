---
import Link from '@/components/ui/Link.astro';
import { getTranslations } from '@/i18n';
import { getLocale } from '@/i18n/routing';
import type { StudyViewModel } from '@/presentation/view-models/study-view-model';
import StudyVisual from '../visuals/StudyVisual.astro';
import Icon from '../ui/Icon.astro';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
interface Props {
  study: StudyViewModel;
  index: number;
}
const { study, index } = Astro.props;
---

<article class="group relative flex h-full min-w-0 flex-col">
  <div
    class="h-80 min-w-0 shrink-0 rounded-lg transition-transform duration-200 group-hover:-translate-y-1"
  >
    <StudyVisual visual={study.visual} compact class="p-5!" />
  </div>
  <div class="flex flex-1 flex-col pt-6">
    <p class="eyebrow flex items-center justify-between text-muted">
      <span>{t.openSource}</span><span class="font-mono">0{index + 1}</span>
    </p>
    <h3
      class="mt-3 font-display text-xl leading-snug font-semibold tracking-tight"
    >
      <Link
        href={study.href}
        class="after:absolute after:inset-x-0 after:top-0 after:h-80 after:rounded-lg hover:text-blue focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-blue"
        >{study.title}</Link
      >
    </h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
      {study.description}
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      {study.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <div
      class="mt-4 flex items-center justify-between border-t border-line pt-2"
    >
      <Link href={study.href} class="text-link text-xs"
        >{t.exploreProject}<Icon name="arrow-up-right" /></Link
      >{
        study.repository && (
          <Link
            href={study.repository}
            aria-label={`${study.title} ${t.onGithub}`}
            class="flex size-11 items-center justify-center rounded-md hover:bg-blue-light hover:text-blue"
          >
            <Icon name="github" />
          </Link>
        )
      }
    </div>
  </div>
</article>
