---
import { getTranslations } from '@/i18n';
import { getLocale, getResumePath } from '@/i18n/routing';
import { getExperiences } from '@/content/profile';
import SectionHeading from '../ui/SectionHeading.astro';
import ExperienceRow from '../work/ExperienceRow.astro';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
const experiences = getExperiences(locale);
import ActionLink from '../ui/ActionLink.astro';
---

<section id="experience" class="section-space">
  <div class="shell">
    <SectionHeading
      number="04"
      label={t.experienceLabel}
      title={t.experienceTitle}
      description={t.experienceDescription}
    /><ol>
      {
        experiences
          .slice(0, 4)
          .map((experience) => <ExperienceRow experience={experience} />)
      }
    </ol><details class="border-y border-line">
      <summary
        class="flex min-h-14 list-none items-center justify-between py-3 text-xs font-medium hover:text-blue"
        ><span>{t.earlierExperience}</span><span aria-hidden="true">＋</span
        ></summary
      ><ol>
        {
          experiences
            .slice(4)
            .map((experience) => <ExperienceRow experience={experience} />)
        }
      </ol>
    </details><div
      class="mt-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-center"
    >
      <p class="max-w-sm text-xs leading-relaxed text-muted">
        {t.education}<br />{t.languages}
      </p><ActionLink
        href={getResumePath(locale)}
        variant="secondary"
        icon="download"
        download>{t.downloadResume}</ActionLink
      >
    </div>
  </div>
</section>
