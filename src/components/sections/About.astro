---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
const principles = [
  {
    number: '01',
    title: 'Start with the problem.',
    text: 'Understand the workflow, constraints, and people before choosing the architecture.',
  },
  {
    number: '02',
    title: 'Make complexity manageable.',
    text: 'Clear boundaries, useful abstractions, and tests that protect meaningful behavior.',
  },
  {
    number: '03',
    title: 'Help the whole team move.',
    text: 'Shared tools, thoughtful reviews, and automated delivery that reduce repetitive work.',
  },
];
const capabilities = [
  {
    icon: 'code' as const,
    title: 'Backend & full-stack',
    text: 'TypeScript · Node.js · NestJS · Laravel · Next.js · React',
  },
  {
    icon: 'layers' as const,
    title: 'Architecture & data',
    text: 'API design · Multi-tenancy · DDD · PostgreSQL · SQL optimization',
  },
  {
    icon: 'terminal' as const,
    title: 'Quality & delivery',
    text: 'Automated testing · CI/CD · Docker · Developer tooling',
  },
];
---

<section id="about" class="section-space border-y border-line bg-[#efefe8]">
  <div class="shell">
    <SectionHeading
      number="03"
      label="The way I work"
      title="Thoughtful engineering. Shared progress."
    />
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div>
        <p
          class="font-display text-xl leading-relaxed font-medium tracking-tight sm:text-2xl"
        >
          I care about what happens after the code ships.
        </p><p class="mt-5 max-w-lg text-sm leading-relaxed text-muted">
          How a system behaves under pressure. How easy it is for the next
          engineer to change it. Whether it solves the problem the business
          actually has.
        </p><p class="mt-4 max-w-lg text-sm leading-relaxed text-muted">
          My experience spans enterprise applications, SaaS platforms, backend
          services, and technical leadership. Across those settings, I keep
          coming back to clear architecture, practical automation, and working
          well with people.
        </p><div class="mt-8 space-y-5">
          {
            capabilities.map((item) => (
              <div class="flex gap-3">
                <>
                  <Icon
                    name={item.icon}
                    class="mt-0.5 size-4 shrink-0 text-blue"
                  />
                  <div>
                    <>
                      <h3 class="text-xs font-semibold">{item.title}</h3>
                      <p class="mt-1 text-xs leading-relaxed text-muted">
                        {item.text}
                      </p>
                    </>
                  </div>
                </>
              </div>
            ))
          }
        </div>
      </div>
      <div class="divide-y divide-line">
        {
          principles.map((item) => (
            <div class="flex gap-5 py-6 first:pt-0">
              <>
                <span class="pt-1 font-mono text-xs text-blue">
                  {item.number}
                </span>
                <div>
                  <>
                    <h3 class="font-display text-lg font-semibold tracking-tight">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted">
                      {item.text}
                    </p>
                  </>
                </div>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
