---
import { getTranslations } from '@/i18n';
import { getLocale } from '@/i18n/routing';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
const principles = [
  {
    number: '01',
    title: t.principleOneTitle,
    text: t.principleOneText,
  },
  {
    number: '02',
    title: t.principleTwoTitle,
    text: t.principleTwoText,
  },
  {
    number: '03',
    title: t.principleThreeTitle,
    text: t.principleThreeText,
  },
];
const capabilities = [
  {
    icon: 'code' as const,
    title: t.backendTitle,
    text: t.backendTools,
  },
  {
    icon: 'layers' as const,
    title: t.architectureTitle,
    text: t.architectureTools,
  },
  {
    icon: 'terminal' as const,
    title: t.deliveryTitle,
    text: t.deliveryTools,
  },
];
---

<section id="about" class="section-space border-y border-line bg-surface-muted">
  <div class="shell">
    <SectionHeading number="03" label={t.aboutLabel} title={t.aboutTitle} />
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div>
        <p
          class="font-display text-xl leading-relaxed font-medium tracking-tight sm:text-2xl"
        >
          {t.aboutLead}
        </p><p class="mt-5 max-w-lg text-sm leading-relaxed text-muted">
          {t.aboutFirst}
        </p><p class="mt-4 max-w-lg text-sm leading-relaxed text-muted">
          {t.aboutSecond}
        </p><div class="mt-8 space-y-5">
          {
            capabilities.map((item) => (
              <div class="flex gap-3">
                <>
                  <Icon
                    name={item.icon}
                    class="mt-0.5 size-4 shrink-0 text-blue"
                  />
                  <div>
                    <>
                      <h3 class="text-xs font-semibold">{item.title}</h3>
                      <p class="mt-1 text-xs leading-relaxed text-muted">
                        {item.text}
                      </p>
                    </>
                  </div>
                </>
              </div>
            ))
          }
        </div>
      </div>
      <div class="divide-y divide-line">
        {
          principles.map((item) => (
            <div class="flex gap-5 py-6 first:pt-0">
              <>
                <span class="pt-1 font-mono text-xs text-blue">
                  {item.number}
                </span>
                <div>
                  <>
                    <h3 class="font-display text-lg font-semibold tracking-tight">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted">
                      {item.text}
                    </p>
                  </>
                </div>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
