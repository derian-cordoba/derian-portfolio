---
import Link from '@/components/ui/Link.astro';
import { getTranslations } from '@/i18n';
import { getLocale } from '@/i18n/routing';
import type { StudyViewModel } from '@/presentation/view-models/study-view-model';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../work/ProjectCard.astro';
import Icon from '../ui/Icon.astro';
import { profile } from '@/content/profile';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
interface Props {
  studies: readonly StudyViewModel[];
}
const { studies } = Astro.props;
---

<section id="projects" class="section-space border-t border-line">
  <div class="shell">
    <SectionHeading
      number="02"
      label={t.projectsLabel}
      title={t.projectsTitle}
      description={t.projectsDescription}
    /><div class="grid gap-10 md:grid-cols-3 md:gap-6 lg:gap-8">
      {
        studies.map((study, index) => (
          <ProjectCard study={study} index={index} />
        ))
      }
    </div><Link href={profile.github} class="text-link mt-8 text-xs text-muted"
      >{t.moreGithub}<Icon name="arrow-up-right" /></Link
    >
  </div>
</section>
