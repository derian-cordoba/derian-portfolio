---
import { getTranslations } from '@/i18n';
import { getLocale } from '@/i18n/routing';
import type { StudyViewModel } from '@/presentation/view-models/study-view-model';
import SectionHeading from '../ui/SectionHeading.astro';
import ExperienceCard from '../work/ExperienceCard.astro';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
interface Props {
  studies: readonly StudyViewModel[];
}
const { studies } = Astro.props;
---

<section id="work" class="section-space border-t border-line">
  <div class="shell">
    <SectionHeading
      number="01"
      label={t.workLabel}
      title={t.workTitle}
      description={t.workDescription}
    /><div class="grid gap-6">
      {studies.map((study) => <ExperienceCard study={study} />)}
    </div>
  </div>
</section>
