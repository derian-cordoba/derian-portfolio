---
import { getFeatureCopy } from '@/i18n/features';
import { getLocale, localizePath } from '@/i18n/routing';
import ActionLink from '@/components/ui/ActionLink.astro';
const locale = getLocale(Astro.url.pathname);
const copy = getFeatureCopy(locale);
const cards = [
  { title: copy.hiring, description: copy.hiringCard, href: '/hiring/' },
  { title: copy.notes, description: copy.notesCard, href: '/notes/' },
];
---

<section class="section-space border-t border-line">
  <div class="shell">
    <p class="eyebrow text-blue">{copy.newSection}</p>
    <h2 class="display-title mt-5 text-3xl sm:text-4xl">
      {copy.newSectionTitle}
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        cards.map((card) => (
          <article class="rounded-xl border border-line bg-surface p-6 sm:p-8">
            <>
              <h3 class="font-display text-xl font-semibold">{card.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                {card.description}
              </p>
              <ActionLink
                href={localizePath(card.href, locale)}
                variant="text"
                icon="arrow-right"
                class="mt-4"
              >
                {card.title}
              </ActionLink>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
