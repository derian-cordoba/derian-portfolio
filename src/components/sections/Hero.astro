---
import Link from '@/components/ui/Link.astro';
import { getTranslations } from '@/i18n';
import { getLocale } from '@/i18n/routing';
import { localizePath } from '@/i18n/routing';
import { getEnhancementCopy } from '@/i18n/enhancements';
import { profile } from '@/content/profile';
import ActionLink from '../ui/ActionLink.astro';
import Icon from '../ui/Icon.astro';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
import SystemMap from '../visuals/SystemMap.astro';
---

<section class="shell pt-16 pb-14 md:pt-24 md:pb-20">
  <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
    <div>
      <p class="eyebrow mb-6 flex items-center gap-2.5 text-muted">
        <span class="size-1.5 rounded-full bg-blue"></span>{t.heroEyebrow}
      </p>
      <h1
        class="display-title max-w-2xl text-[clamp(2.9rem,6vw,5.25rem)] leading-[1.08]"
      >
        {t.heroTitle}<br /><span class="text-blue">{t.heroAccent}</span>
      </h1>
      <p class="mt-6 max-w-md text-base leading-relaxed text-muted sm:text-lg">
        {t.heroDescription}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <ActionLink href="#work" icon="arrow-right">{t.exploreWork}</ActionLink
        ><ActionLink href="#contact" variant="text">{t.letsTalk}</ActionLink>
      </div>
      <a
        href={localizePath('/hiring/', locale)}
        class="text-link mt-3 text-xs text-blue"
      >
        {getEnhancementCopy(locale).hiringShortcut}<Icon
          name="arrow-right"
          class="size-3.5"
        />
      </a>
      <div
        class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3 text-[11px] text-muted"
      >
        <span
          >{profile.location}
          <span class="ml-1 text-muted">/ {profile.timezone}</span></span
        ><Link
          href={profile.github}
          class="flex min-h-8 items-center gap-1.5 hover:text-blue"
          ><Icon name="github" class="size-3.5" />GitHub<Icon
            name="arrow-up-right"
            class="size-3"
          /></Link
        ><Link
          href={profile.linkedin}
          class="flex min-h-8 items-center gap-1.5 hover:text-blue"
          >LinkedIn<Icon name="arrow-up-right" class="size-3" /></Link
        >
      </div>
    </div>
    <div class="relative lg:pl-3">
      <SystemMap /><div
        class="absolute -right-2 -bottom-4 max-w-[calc(100%-1rem)] rounded-lg border border-line bg-paper px-4 py-3 shadow-sm sm:-right-4"
      >
        <p class="text-[11px] font-medium">
          {t.heroNote}
        </p><p class="mt-1 font-mono text-[9px] text-muted">
          {t.deliveryFlow}
        </p>
      </div>
    </div>
  </div>
  <div
    class="mt-16 grid grid-cols-1 gap-6 border-t border-line pt-8 sm:grid-cols-3 md:mt-20"
  >
    <div>
      <p class="font-display text-3xl font-semibold tracking-tight">
        7+ <span class="text-sm font-normal text-muted">{t.years}</span>
      </p><p class="mt-1 text-xs text-muted">
        {t.yearsDescription}
      </p>
    </div>
    <div class="sm:border-l sm:border-line sm:pl-8">
      <p class="font-display text-3xl font-semibold tracking-tight">
        {t.performanceValue}<span class="text-xl">%</span>
      </p><p class="mt-1 text-xs text-muted">
        {t.performanceDescription}
      </p>
    </div>
    <div class="sm:border-l sm:border-line sm:pl-8">
      <p class="font-display text-3xl font-semibold tracking-tight">
        25+ <span class="text-sm font-normal text-muted">{t.companies}</span>
      </p><p class="mt-1 text-xs text-muted">
        {t.companiesDescription}
      </p>
    </div>
  </div>
</section>
