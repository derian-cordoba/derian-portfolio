---
const source = import.meta.env['PUBLIC_PLAUSIBLE_SCRIPT_URL']?.trim();
const measurementHost =
  import.meta.env['PUBLIC_ANALYTICS_HOSTNAME']?.trim() || Astro.site?.hostname;

if (
  measurementHost &&
  new URL(`https://${measurementHost}`).hostname !== measurementHost
) {
  throw new Error(
    'PUBLIC_ANALYTICS_HOSTNAME must contain only the public hostname to measure.',
  );
}

if (source && !/^https:\/\/plausible\.io\/js\/pa-[\w-]+\.js$/u.test(source)) {
  throw new Error(
    'PUBLIC_PLAUSIBLE_SCRIPT_URL must be the HTTPS script URL supplied by Plausible.',
  );
}
---

{
  source && (
    <meta
      name="portfolio-analytics"
      content={source}
      data-host={measurementHost}
    />
  )
}
<script>
  import '@/presentation/controllers/engagement';
</script>
