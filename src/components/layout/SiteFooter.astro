---
import { getTranslations } from '@/i18n';
import { getLocale, localizePath } from '@/i18n/routing';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
import { profile } from '@/content/profile';
---

<footer class="border-t border-line">
  <div
    class="shell flex flex-col justify-between gap-4 py-7 text-[11px] text-muted sm:flex-row"
  >
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p>{t.footerNote}</p>
    <a
      href={localizePath('/#top', locale)}
      class="underline-offset-4 hover:text-blue hover:underline"
      >{t.backToTop} ↑</a
    >
  </div>
</footer>
