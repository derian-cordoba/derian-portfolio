---
import { getTranslations } from '@/i18n';
import { getLocale, localizePath, getResumePath } from '@/i18n/routing';
import ActionLink from '../ui/ActionLink.astro';
import Icon from '../ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
const links = [
  { label: t.navWork, href: localizePath('/#work', locale) },
  { label: t.navAbout, href: localizePath('/#about', locale) },
  { label: t.navExperience, href: localizePath('/#experience', locale) },
  { label: t.navContact, href: localizePath('/#contact', locale) },
];
---

<header
  class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-md"
>
  <div class="shell flex h-20 items-center justify-between gap-4">
    <a
      href={localizePath('/', locale)}
      aria-label={t.homeLabel}
      class="group flex items-center gap-3"
    >
      <span
        class="font-display text-[30px] font-extrabold tracking-[-0.09em] text-blue"
        >dc<span class="text-ink">.</span></span
      >
      <span
        class="hidden border-l border-line pl-3 text-xs font-medium lg:inline"
        >Derian Córdoba</span
      >
    </a>
    <nav
      aria-label={t.mainNavigation}
      class="hidden items-center gap-5 lg:flex"
    >
      {
        links.map((link) => (
          <a href={link.href} class="text-link text-xs">
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageSwitcher />
      <ActionLink
        href={getResumePath(locale)}
        variant="secondary"
        icon="download"
        download
        class="hidden! min-h-10! px-3! py-2! text-xs! sm:inline-flex!"
        >{t.resume}</ActionLink
      >
      <details class="relative lg:hidden" data-mobile-menu>
        <summary
          class="flex min-h-11 min-w-11 list-none items-center justify-center rounded-md border border-line"
          aria-label={t.toggleNavigation}
          ><Icon name="menu" class="size-5" /></summary
        >
        <nav
          aria-label={t.mobileNavigation}
          class="absolute top-14 right-0 flex w-52 flex-col rounded-lg border border-line bg-paper p-3 shadow-lg"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-4 py-3 text-sm hover:bg-blue-light"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) {
      menu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
