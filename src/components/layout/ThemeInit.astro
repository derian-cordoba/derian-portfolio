---
import { THEME_STORAGE_KEY } from '@/infrastructure/theme-preference';
---

<!-- Runs before body rendering so a saved preference does not flash light. -->
<script is:inline data-theme-init data-storage-key={THEME_STORAGE_KEY}>
  (() => {
    const storageKey = document.currentScript?.getAttribute('data-storage-key');
    let preference;
    try {
      preference = storageKey ? window.localStorage.getItem(storageKey) : null;
    } catch {
      preference = null;
    }
    const theme =
      preference === 'light' || preference === 'dark'
        ? preference
        : window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
    document.documentElement.dataset.theme = theme;
  })();
</script>
