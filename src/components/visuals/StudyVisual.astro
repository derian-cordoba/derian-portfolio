---
import type { StudyVisual } from '@/domain/study';
import PerformanceVisual from './PerformanceVisual.astro';
import PlatformVisual from './PlatformVisual.astro';
import GatewayVisual from './GatewayVisual.astro';
import ExperimentVisual from './ExperimentVisual.astro';
import SecureKeysVisual from './SecureKeysVisual.astro';
interface Props {
  visual: StudyVisual;
  compact?: boolean;
}
const { visual, compact = false } = Astro.props;
const visuals = {
  performance: { component: PerformanceVisual, background: 'bg-[#e9eef6]' },
  platform: { component: PlatformVisual, background: 'bg-[#e8eee8]' },
  gateway: {
    component: GatewayVisual,
    background: 'technical-grid bg-navy text-white',
  },
  experimentation: { component: ExperimentVisual, background: 'bg-[#eae8f3]' },
  'secure-keys': { component: SecureKeysVisual, background: 'bg-[#eeece5]' },
};
const { component: Visual, background } = visuals[visual];
---

<div
  class:list={[
    'relative flex h-full min-h-56 flex-col justify-center overflow-hidden rounded-lg p-6 sm:p-8',
    background,
  ]}
>
  <Visual compact={compact} />
</div>
