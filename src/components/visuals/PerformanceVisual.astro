---
import { getTranslations } from '@/i18n';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
import { getLocale } from '@/i18n/routing';
---

<div>
  <div class="eyebrow mb-7 text-blue">{t.performanceVisualTitle}</div>
  <div class="flex items-end justify-between gap-4">
    <>
      <span
        class="font-display text-6xl font-medium tracking-[-0.07em] text-blue sm:text-7xl"
      >
        80<span class="text-3xl">%</span>
      </span>
      <span class="max-w-24 pb-2 text-[10px] leading-relaxed text-muted">
        {t.performanceScope}
      </span>
    </>
  </div>
  <div class="mt-6 space-y-2" aria-hidden="true">
    <>
      <div class="h-1.5 w-full rounded-full bg-blue/15"></div>
      <div class="h-1.5 w-1/5 rounded-full bg-blue"></div>
    </>
  </div>
  <p class="mt-4 font-mono text-[9px] text-muted">
    {t.performanceTools}
  </p>
</div>
