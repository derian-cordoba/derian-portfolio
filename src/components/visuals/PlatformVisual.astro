---
import { getTranslations } from '@/i18n';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
import { getLocale } from '@/i18n/routing';
---

<div>
  <div class="eyebrow mb-6 text-success">{t.platformVisualTitle}</div>
  <div class="flex justify-center gap-2" aria-hidden="true">
    {
      ['A', 'B', 'C'].map((label) => (
        <div class="flex size-12 items-center justify-center rounded-md border border-success/20 bg-diagram-surface font-mono text-sm text-success">
          {label}
        </div>
      ))
    }
  </div>
  <div class="mx-auto h-5 w-px bg-success/30"></div>
  <div
    class="mx-auto max-w-56 rounded-md border border-success/30 bg-diagram-surface py-3 text-center font-mono text-[11px] text-success"
  >
    {t.sharedServices}
  </div>
  <p class="mt-6 text-center text-[10px] text-success">
    {t.platformVisualNote}
  </p>
</div>
