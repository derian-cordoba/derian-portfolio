---
import '@/styles/global.css';
import '@/styles/transitions.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SearchVerification from '@/components/layout/SearchVerification.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import ThemeInit from '@/components/layout/ThemeInit.astro';
import Engagement from '@/components/layout/Engagement.astro';
import PageNavigation from '@/components/layout/PageNavigation.astro';
import { pageTransition } from '@/presentation/transitions';
import { profile } from '@/content/profile';
import { locales } from '@/domain/locale';
import { getTranslations } from '@/i18n';
import { getLocale, localizePath } from '@/i18n/routing';
import type { LanguageHashMaps } from '@/i18n/routing';
const locale = getLocale(Astro.url.pathname);
const t = getTranslations(locale);
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  languageHashMaps?: LanguageHashMaps;
  socialImagePath?: string;
  socialImageAlt?: string;
  entity?: {
    type: 'BlogPosting' | 'CreativeWork';
    publishedAt?: string;
    updatedAt?: string;
    keywords?: readonly string[];
  };
}
const {
  title = t.pageTitle,
  description = t.pageDescription,
  noindex = false,
  languageHashMaps = {},
  socialImagePath,
  socialImageAlt = t.socialAlt,
  entity,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(
  socialImagePath ??
    (locale === 'es' ? '/social-card-es.png' : '/social-card.png'),
  Astro.site,
);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: profile.name,
  jobTitle: t.jobTitle,
  url: new URL(localizePath('/', locale), Astro.site).href,
  sameAs: [profile.github, profile.linkedin],
};
const structuredData = entity
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        person,
        {
          '@type': entity.type,
          '@id': `${canonical.href}#content`,
          url: canonical.href,
          headline: title.replace(` — ${profile.name}`, ''),
          description,
          image: socialImage.href,
          inLanguage: locale,
          author: { '@id': person['@id'] },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
          ...(entity.publishedAt && { datePublished: entity.publishedAt }),
          ...(entity.updatedAt && { dateModified: entity.updatedAt }),
          ...(entity.keywords && { keywords: entity.keywords.join(', ') }),
        },
      ],
    }
  : person;
---

<!doctype html>
<html lang={locale} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f7f7f2"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b1420"
      media="(prefers-color-scheme: dark)"
    />
    <ThemeInit />
    <PageNavigation />
    <Engagement />
    <ClientRouter fallback="animate" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SearchVerification />
    <link rel="canonical" href={canonical} />
    {
      locales.map((language) => (
        <link
          rel="alternate"
          hreflang={language}
          href={new URL(localizePath(Astro.url.pathname, language), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath(Astro.url.pathname, 'en'), Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta
      property="og:type"
      content={entity?.type === 'BlogPosting' ? 'article' : 'website'}
    />
    {
      entity?.publishedAt && (
        <meta property="article:published_time" content={entity.publishedAt} />
      )
    }
    {
      entity?.updatedAt && (
        <meta property="article:modified_time" content={entity.updatedAt} />
      )
    }
    <meta property="og:locale" content={locale === 'es' ? 'es_NI' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'es' ? 'en_US' : 'es_NI'}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</gu, '\\u003c')}
    />
  </head>
  <body id="top">
    <a
      href="#main"
      class="sr-only fixed top-3 left-3 z-50 rounded-md bg-action px-5 py-3 text-on-action focus:not-sr-only"
      >{t.skipContent}</a
    >
    <SiteHeader languageHashMaps={languageHashMaps} />
    <main
      id="main"
      tabindex="-1"
      transition:name="page-content"
      transition:animate={pageTransition}
    >
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
